# Copy selected settings to your existing .env; do not overwrite existing keys.
# Default demo date matches sample_data/orders.json.
AGENT_MODE=aftersales
AFTERSALES_DEMO_DATE=2026-10-11
# Optional local SQLite path; default data/aftersales.sqlite3
# AFTERSALES_DB_PATH=data/aftersales.sqlite3

# Text model: DeepSeek (chat, routing, tools)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Image understanding: Qwen3-VL-Plus via Alibaba Cloud Bailian (Beijing).
# Leave empty for text-only chat; DASHSCOPE_API_KEY is also accepted.
VISION_API_KEY=
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus
# Optional Beijing workspace endpoint:
# VISION_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# memory: single-process demo, history disappears after restart.
# postgres: persistent conversations; also requires DATABASE_URL.
MEMORY_BACKEND=memory
# DATABASE_URL=postgresql://user:password@host:5432/dbname
MAX_ITERATIONS=5

# Policy retrieval: existing index, default namespace; BGE-M3 requires 1024 dimensions.
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=ecommerce-aftersales
SILICONFLOW_API_KEY=your-siliconflow-api-key
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
# Optional independent policy index; defaults to PINECONE_INDEX.
# AFTERSALES_PINECONE_INDEX=ecommerce-aftersales
# AFTERSALES_PINECONE_NAMESPACE=
# Tavily / MCP credentials are not required for aftersales mode.
